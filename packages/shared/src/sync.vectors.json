    {
      "name": "null presence",
      "statePlaying": true,
      "presence": null,
      "buffering": [],
      "effectivePlaying": true
    },
    {
      "name": "paused state",
      "statePlaying": false,
      "presence": {},
      "buffering": [],
      "effectivePlaying": false
    },
    {
      "name": "offline buffering ignored",
      "statePlaying": true,
      "presence": {
        "a": {
          "online": false,
          "buffering": true
        },
        "b": {
          "online": true,
          "buffering": false
        }
      },
      "buffering": [],
      "effectivePlaying": true
    }
  ]
}
